# Server-only RAG API base URL (preferred). Used by /api/ask proxy.
# Local FastAPI default:
RAG_API_URL=http://127.0.0.1:8000

# Production (Netlify): set RAG_API_URL to your deployed FastAPI service, e.g.
# RAG_API_URL=https://YOUR-RAG-API.up.railway.app
#
# Optional fallback if you must call the API from the client (not preferred):
# NEXT_PUBLIC_RAG_API_URL=https://YOUR-RAG-API.up.railway.app

# Contact form email (existing)
# GMAIL_USER=
# GMAIL_PASS=
